<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mini Message Board</title>
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body>
    <main>
      <div class="header">
        <h1>The Board of Messages</h1>
        <div class="add-message"><button>Add Message</button></div>
      </div>

      <div class="content">
        <div class="board">
          <div class="messages">
            <% messages.forEach(msg => { %>
              <div class="message">

                <div class="message-header"><h3 class="user-name"><%= msg.user %></h3> <p class="message-date"><%= msg.added %></p></div>
                <hr>
                <div class="message-content"><p class="message-text"><%= msg.text %></p></div>
              </div>
              <% }) %>
          </div>
        </div>
      </div>
    </main>
  </body>
</html>
