<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mini Message Board</title>
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body>
    <div class="create-message content">
      <h1>Create Message</h1>
      <form action="/new" method="POST">
        <input
          type="text"
          id="user"
          name="userField"
          placeholder="Username"
          required
        />
        <textarea
          rows="5"
          cols="60"
          type="text"
          id="message-text"
          name="messageField"
          placeholder="Message"
          required
        ></textarea>
        <button>Post</button>
      </form>
      <a href="/">
        <button class="back">Back to Message Board</button>
      </a>
    </div>
  </body>
</html>
